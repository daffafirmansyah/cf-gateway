# CF Workers AI Gateway
# Copy this to .env and fill in your values

# Server
CF_GATEWAY_HOST=0.0.0.0
CF_GATEWAY_PORT=8750

# API Key (clients use this to authenticate)
# Generate: openssl rand -hex 16
CF_GATEWAY_API_KEY=

# Database
CF_GATEWAY_DB=./data/accounts.db

# Pool settings
CF_GATEWAY_COOLDOWN_429=90
CF_GATEWAY_MAX_RETRIES=5

# Logging
CF_GATEWAY_LOG_LEVEL=INFO

# Optional: 9router DB path (for importing accounts from 9router)
# CF_GATEWAY_9ROUTER_DB=/path/to/.9router/db/data.sqlite
